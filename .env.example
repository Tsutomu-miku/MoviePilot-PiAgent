# Copy to .env and load it with node --env-file=.env dist/src/cli.js.
# Set one explicit provider/model pair; no automatic model pool.
AGENT_PROVIDER=openrouter
AGENT_MODEL=
OPENROUTER_API_KEY=
AGENT_DATA_DIR=./data
AGENT_CONVERSATION_ID=default
# Optional, used only by MoviePilot business tools.
MOVIEPILOT_URL=http://moviepilot:3000/api/v1/
MOVIEPILOT_ACCESS_TOKEN=

# Node.js service
HOST=127.0.0.1
PORT=8787
AGENT_DATA_DIR=./data
AGENT_OWNER_ID=owner
# Generate: node -e 'console.log(require("node:crypto").randomBytes(32).toString("hex"))'
WEB_AUTH_TOKEN=replace-with-a-random-token-of-at-least-32-characters

# Select ONE Pi provider/model. No free model pool or automatic model switching.
AGENT_PROVIDER=openai
AGENT_MODEL=gpt-4.1
# Either set this key or use data/pi/auth.json managed by Pi.
AGENT_API_KEY=replace-with-your-api-key
# Optional OpenAI-compatible endpoint. Leave this line out for a built-in Pi provider.
# AGENT_BASE_URL=https://your-configured-endpoint.example/v1
# For custom endpoints, set the model's actual limits.
AGENT_CONTEXT_WINDOW=128000
AGENT_MAX_TOKENS=8192

# Exact MoviePilot API prefix; retain your configured address/proxy.
MOVIEPILOT_URL=http://moviepilot:3000/api/v1/
MOVIEPILOT_USERNAME=admin
MOVIEPILOT_PASSWORD=replace-with-your-password
# An access token can be used instead of account credentials.
# MOVIEPILOT_ACCESS_TOKEN=replace-with-your-token
# MOVIEPILOT_DOWNLOADER=your-configured-downloader-name
# MOVIEPILOT_SAVE_PATH=/downloads
MOVIEPILOT_UTC_OFFSET_MINUTES=480
TASK_POLL_SECONDS=30

# Optional Feishu UI. Use open_id values, comma separated.
FEISHU_ENABLED=false
# FEISHU_APP_ID=cli_your_app_id
# FEISHU_APP_SECRET=replace-with-your-app-secret
FEISHU_ALLOWED_OPEN_IDS=
FEISHU_ALLOWED_GROUP_IDS=

# Keep your own proxy and mirror settings. The project does not pin npm's registry.
# Node fetch uses --use-env-proxy. Feishu WebSocket uses the same HTTPS/HTTP proxy.
# HTTPS_PROXY=http://your-proxy:7890
# HTTP_PROXY=http://your-proxy:7890
# NO_PROXY=localhost,127.0.0.1,moviepilot,192.168.31.82

{
  "name": "@mp-pi/api",
  "version": "1.2.4",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "dev": "NODE_USE_ENV_PROXY=1 tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node --use-env-proxy --env-file-if-exists=../../.env dist/src/server.js",
    "cli": "node --use-env-proxy --env-file-if-exists=../../.env dist/src/cli.js"
  },
  "dependencies": {
    "@mp-pi/contracts": "1.2.4",
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@larksuiteoapi/node-sdk": "1.74.0",
    "fastify": "5.12.5",
    "@fastify/static": "10.1.5",
    "@fastify/rate-limit": "11.2.0",
    "zod": "4.6.5",
    "typebox": "1.3.27",
    "drizzle-orm": "0.45.3",
    "better-sqlite3": "13.0.3",
    "proper-lockfile": "4.1.2",
    "https-proxy-agent": "9.1.0"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "@types/better-sqlite3": "9.6.0",
    "@types/proper-lockfile": "4.1.4"
  }
}
